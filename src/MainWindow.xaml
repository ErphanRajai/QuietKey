<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietKey" Width="468" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="#F3F5FA">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9AA9BC" />
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F3F5FA" /><Setter Property="Background" Value="#222D40" />
      <Setter Property="BorderBrush" Value="#344058" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,11" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#72E5C3" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#102E28" /><Setter Property="Background" Value="#72E5C3" />
      <Setter Property="BorderBrush" Value="#72E5C3" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,13" />
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A6B6CB" /><Setter Property="Padding" Value="8,6" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F3F5FA" /><Setter Property="Background" Value="#101827" />
      <Setter Property="BorderBrush" Value="#3A4860" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="#72E5C3" /><Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="18" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F3F5FA" /><Setter Property="Background" Value="#222D40" />
      <Setter Property="BorderBrush" Value="#344058" /><Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="13" />
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#222D40" /><Setter Property="Foreground" Value="#F3F5FA" /><Setter Property="Padding" Value="12,9" />
        <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#344058" /></Trigger></Style.Triggers>
      </Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><TextBlock Text="⌄" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9AA9BC" /></Border>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="12,11,32,11" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#222D40" BorderBrush="#344058" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0"><ScrollViewer MaxHeight="260"><ItemsPresenter /></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="#72E5C3" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D6DFEB" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style x:Key="ModeSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="50" /><Setter Property="Height" Value="28" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Grid Width="50" Height="28">
          <Border x:Name="Track" Background="#46536A" CornerRadius="14" BorderBrush="#5A6880" BorderThickness="1" />
          <Ellipse x:Name="Knob" Width="22" Height="22" Fill="#E4EAF2" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="ThumbSlide" X="0" /></Ellipse.RenderTransform></Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="#72E5C3" /><Setter TargetName="Track" Property="BorderBrush" Value="#72E5C3" /><Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFF" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5" /><Setter TargetName="Knob" Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="#141D2C" BorderBrush="#344058" BorderThickness="1" CornerRadius="18" Margin="10">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.35" /></Border.Effect>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24,20,24,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="Header" Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" Background="#203C38" CornerRadius="9" Margin="0,0,10,0"><TextBlock Text="Q" Foreground="#72E5C3" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="QuietKey" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="HideButton" Grid.Column="1" Content="✕" ToolTip="Hide to tray (Esc)" Style="{StaticResource Link}" AutomationProperties.Name="Hide to tray" FontSize="14" />
      </Grid>
      <StackPanel Grid.Row="1">
        <StackPanel x:Name="HomePage">
          <TextBlock Text="Your PC, your way." FontSize="26" FontWeight="SemiBold" Margin="0,0,0,5" />
          <TextBlock Text="Wind down or power up, one key away." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,22" />
          <Button x:Name="TimerCard" HorizontalContentAlignment="Stretch" Padding="18,18" Margin="0,0,0,12" Background="#1C283A">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" Background="#25423F" CornerRadius="10" VerticalAlignment="Top"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="4" Stroke="#72E5C3" StrokeThickness="1.8" /><Path Data="M12,8 L12,13 L15,15 M9,1 L15,1 M12,1 L12,4" Stroke="#72E5C3" StrokeThickness="1.8" /></Canvas></Viewbox></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Sleep timer" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="TimerDescription" Text="Shut down after a set number of minutes." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,4,0" /></StackPanel>
              <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="#8294AF" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Border x:Name="CountdownPanel" Visibility="Collapsed" Background="#203531" BorderBrush="#365E52" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="CountdownText" Foreground="#72E5C3" FontSize="21" FontWeight="SemiBold" /><TextBlock x:Name="DeadlineText" Foreground="#A4C6BA" FontSize="11" Margin="0,3,0,0" /></StackPanel>
              <Button x:Name="CancelTimerButton" Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Padding="12,7" Background="#29483F" BorderBrush="#49695E" />
            </Grid>
          </Border>
          <Border Background="#1C283A" BorderBrush="#344058" BorderThickness="1" CornerRadius="9" Margin="0,0,0,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button x:Name="SleepCard" HorizontalContentAlignment="Stretch" Padding="18,18" Background="Transparent" BorderThickness="0" ToolTip="Apply the saved bedtime profile">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" Background="#35324D" CornerRadius="10" VerticalAlignment="Top"><Viewbox Width="19" Height="19"><Path Data="M18,3 C10,1 3,7 3,14 C3,20 10,23 16,20 C20,18 22,15 22,12 C15,16 10,8 18,3 Z" Stroke="#C3B2F3" StrokeThickness="1.8" /></Viewbox></Border>
                  <StackPanel Grid.Column="1"><TextBlock Text="Sleep mode" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ProfileDescription" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,2,0" /></StackPanel>
                </Grid>
              </Button>
              <StackPanel Grid.Column="1" Margin="4,9,14,12" Width="58"><Button x:Name="EditProfileButton" Content="Edit" Style="{StaticResource Link}" AutomationProperties.Name="Edit sleep mode" /><ToggleButton x:Name="SleepToggle" Style="{StaticResource ModeSwitch}" Margin="0,4,0,0" AutomationProperties.Name="Sleep mode on or off" /><TextBlock x:Name="SleepState" Text="Off" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
            </Grid>
          </Border>
          <Border Background="#22283D" BorderBrush="#3D435D" BorderThickness="1" CornerRadius="9" Margin="0,0,0,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button x:Name="GamingCard" HorizontalContentAlignment="Stretch" Padding="18,18" Background="Transparent" BorderThickness="0" ToolTip="Toggle Gaming mode">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" Background="#393553" CornerRadius="10" VerticalAlignment="Top"><TextBlock Text="ϟ" Foreground="#C3B2F3" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1"><TextBlock Text="Gaming mode" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="GamingDescription" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,2,0" /></StackPanel>
                </Grid>
              </Button>
              <StackPanel Grid.Column="1" Margin="4,9,14,12" Width="58"><Button x:Name="EditGamingButton" Content="Edit" Style="{StaticResource Link}" AutomationProperties.Name="Edit gaming mode" /><ToggleButton x:Name="GamingToggle" Style="{StaticResource ModeSwitch}" Margin="0,4,0,0" AutomationProperties.Name="Gaming mode on or off" /><TextBlock x:Name="GamingState" Text="Off" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
            </Grid>
          </Border>
          <Button x:Name="RestoreButton" Content="↶  Switch modes off / retry restoration" Style="{StaticResource Link}" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,4" />
          <TextBlock Text="One mode at a time. Switch off to restore settings." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,3,0,8" />
        </StackPanel>
        <StackPanel x:Name="TimerPage" Visibility="Collapsed">
          <Button x:Name="TimerBack" Content="‹  All shortcuts" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="-8,-8,0,12" />
          <TextBlock Text="Sleep timer" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="How many minutes until shutdown?" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,20" />
          <TextBlock Text="MINUTES" FontSize="10" Foreground="#A6B6CB" Margin="0,0,0,8" />
          <TextBox x:Name="MinutesInput" Text="30" AutomationProperties.Name="Shutdown delay in minutes" MaxLength="5" />
          <UniformGrid Columns="4" Margin="0,10,0,18"><Button x:Name="Minutes15" Content="15" Margin="0,0,6,0" /><Button x:Name="Minutes30" Content="30" Margin="0,0,6,0" /><Button x:Name="Minutes60" Content="60" Margin="0,0,6,0" /><Button x:Name="Minutes90" Content="90" /></UniformGrid>
          <Border Background="#2D2B2A" CornerRadius="9" Padding="12" Margin="0,0,0,18"><TextBlock Text="Save your work first. Windows closes apps when this timer ends. The timer continues if QuietKey exits." Foreground="#CEBBA1" FontSize="12" /></Border>
          <Button x:Name="StartTimerButton" Content="Start shutdown timer" Style="{StaticResource Primary}" Margin="0,0,0,10" />
        </StackPanel>
        <StackPanel x:Name="ProfilePage" Visibility="Collapsed">
          <Button x:Name="ProfileBack" Content="‹  All shortcuts" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="-8,-8,0,12" />
          <TextBlock x:Name="ProfileTitle" Text="Your sleep mode" FontSize="25" FontWeight="SemiBold" />
          <TextBlock x:Name="ProfileHint" Text="Choose what changes when you enable Sleep mode." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,20" />
          <Grid Margin="0,0,0,12"><CheckBox x:Name="BrightnessEnabled" Content="Set display brightness" IsChecked="True" /><TextBlock x:Name="BrightnessValue" Text="25%" HorizontalAlignment="Right" Foreground="#72E5C3" FontWeight="SemiBold" /></Grid>
          <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="25" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,17" AutomationProperties.Name="Display brightness percentage" />
          <TextBlock Text="Night Light" FontSize="13" Margin="0,0,0,7" />
          <ComboBox x:Name="NightLightChoice" SelectedIndex="0" Margin="0,0,0,17"><ComboBoxItem Content="Turn on" Tag="On" /><ComboBoxItem Content="Turn off" Tag="Off" /><ComboBoxItem Content="Keep current setting" Tag="Keep" /></ComboBox>
          <TextBlock Text="Fan / performance preset" FontSize="13" Margin="0,0,0,7" />
          <ComboBox x:Name="FanChoice" SelectedIndex="0" Margin="0,0,0,10"><ComboBoxItem Content="Silent" Tag="Silent" /><ComboBoxItem Content="Performance" Tag="Performance" /><ComboBoxItem Content="Turbo (requires AC power)" Tag="Turbo" /><ComboBoxItem Content="Keep current setting" Tag="Keep" /></ComboBox>
          <TextBlock Text="Windows power mode" FontSize="13" Margin="0,5,0,7" />
          <ComboBox x:Name="PowerChoice" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="Best power efficiency" Tag="Efficiency" /><ComboBoxItem Content="Balanced" Tag="Balanced" /><ComboBoxItem Content="Best performance" Tag="Performance" /><ComboBoxItem Content="Keep current setting" Tag="Keep" /></ComboBox>
          <CheckBox x:Name="EnableGameMode" Content="Enable Windows Game Mode" Visibility="Collapsed" Margin="0,0,0,14" />
          <TextBlock x:Name="HardwareNote" Text="ASUS presets use your laptop's firmware. Armoury Crate can change the mode later." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,16" />
          <Button x:Name="SaveProfileButton" Content="Save sleep mode" Style="{StaticResource Primary}" Margin="0,0,0,10" />
          <Button x:Name="NightLightSettingsButton" Content="Open Windows Night Light settings ↗" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="-8,0,0,5" />
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <Button x:Name="SettingsBack" Content="‹  All shortcuts" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="-8,-8,0,12" />
          <TextBlock Text="Make it yours" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="Ready in the background when you need it." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,22" />
          <CheckBox x:Name="StartupEnabled" Content="Start with Windows" Margin="0,0,0,7" />
          <TextBlock Text="Starts quietly in your system tray after sign-in." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,22" />
          <TextBlock Text="Open / hide shortcut" FontSize="13" Margin="0,0,0,7" />
          <ComboBox x:Name="HotkeyChoice" Margin="0,0,0,20"><ComboBoxItem Content="Ctrl + Alt + Space" Tag="Space" /><ComboBoxItem Content="Ctrl + Alt + Q" Tag="Q" /><ComboBoxItem Content="Ctrl + Alt + K" Tag="K" /><ComboBoxItem Content="Ctrl + Alt + S" Tag="S" /></ComboBox>
          <Button x:Name="SaveSettingsButton" Content="Save settings" Style="{StaticResource Primary}" Margin="0,0,0,14" />
          <TextBlock Text="Close this panel or press Esc to return to the tray. Use Exit in the tray menu to stop the app." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
          <Button x:Name="OpenStartupSettingsButton" Content="Windows startup apps ↗" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="-8,0,0,4" />
        </StackPanel>
      </StackPanel>
      <Border x:Name="StatusPanel" Grid.Row="2" Visibility="Collapsed" Background="#243247" CornerRadius="10" Padding="13,11" Margin="0,8,0,12">
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="StatusText" FontSize="12" Foreground="#D3DFEE" /></ScrollViewer>
      </Border>
      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StartupDot" Width="5" Height="5" Fill="#72E5C3" Margin="0,0,6,0" /><TextBlock x:Name="ShortcutLabel" Text="Ctrl + Alt + Space" FontSize="11" Foreground="#A6B6CB" /></StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings" Style="{StaticResource Link}" FontSize="11" Padding="6,5" />
      </Grid>
    </Grid>
    </ScrollViewer>
  </Border>
</Window>
